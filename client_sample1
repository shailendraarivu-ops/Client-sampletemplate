<style>
:root{
  --chalk:#f3f5ee; --paper:#fff; --ink:#10281f; --grass:#1d6b45; --grass-d:#14503a;
  --line:#d5ddd0; --cone:#ff6a2b; --cone-d:#e85a1e; --muted:#5b6b62; --booked:#e6e9e2;
  --display:'Barlow Condensed',Impact,sans-serif; --body:'Barlow',system-ui,sans-serif;
}
*{box-sizing:border-box;margin:0}
html{scroll-behavior:smooth}
body{font-family:var(--body);background:var(--chalk);color:var(--ink);line-height:1.55;font-size:17px;padding-bottom:64px}
a{color:inherit}
:focus-visible{outline:3px solid var(--cone);outline-offset:2px}
.wrap{max-width:1080px;margin:0 auto;padding:0 20px}
@media(min-width:861px){body{padding-bottom:0}}

/* sample ribbon */
.sample{background:var(--ink);color:#fff;font-size:13px;text-align:center;padding:6px 12px}
.sample b{color:#ffb98f}

/* header */
header.top{position:sticky;top:0;z-index:20;background:var(--chalk);border-bottom:1px solid var(--line)}
.top .wrap{display:flex;align-items:center;justify-content:space-between;height:60px;gap:14px}
.brand{font-family:var(--display);font-weight:800;font-size:24px;letter-spacing:.02em;text-decoration:none}
.top nav{display:flex;gap:22px;font-weight:500;font-size:15px}
.top nav a{text-decoration:none;color:var(--muted)}
.top nav a:hover{color:var(--ink)}
@media(max-width:760px){.top nav{display:none}}
.callbtn{display:inline-flex;align-items:center;gap:8px;background:var(--cone);color:#fff;text-decoration:none;font-weight:600;padding:9px 18px;border-radius:6px;font-size:15px;white-space:nowrap}
.callbtn:hover{background:var(--cone-d)}

/* hero */
.hero{background:var(--grass-d);color:#fff;position:relative;overflow:hidden}
.hero svg.markings{position:absolute;inset:0;width:100%;height:100%;opacity:.22}
.hero .wrap{position:relative;padding-top:64px;padding-bottom:60px;display:grid;gap:36px;align-items:center}
@media(min-width:900px){.hero .wrap{grid-template-columns:1.1fr .9fr}}
.hero h1{font-family:var(--display);font-weight:800;font-size:clamp(52px,10vw,112px);line-height:.88;text-transform:uppercase;max-width:9ch}
.hero p.sub{margin-top:20px;max-width:46ch;font-size:19px;color:#dcebe1}
.facts{display:flex;flex-wrap:wrap;gap:10px;margin-top:24px}
.fact{border:1.5px solid rgba(255,255,255,.55);border-radius:999px;padding:6px 16px;font-weight:500;font-size:15px}
.fact.live{background:#fff;color:var(--grass-d);border-color:#fff}
.hero-cta{display:flex;flex-wrap:wrap;gap:12px;margin-top:28px}
.cta{display:inline-block;background:var(--cone);color:#fff;font-weight:600;text-decoration:none;padding:14px 26px;border-radius:6px;font-size:17px}
.cta:hover{background:var(--cone-d)}
.cta.alt{background:transparent;border:1.5px solid #fff}
.cta.alt:hover{background:rgba(255,255,255,.12)}

/* quote form card */
.qcard{background:var(--paper);color:var(--ink);border-radius:12px;padding:24px;border:1.5px solid var(--ink);box-shadow:8px 8px 0 rgba(0,0,0,.25)}
.qcard h2{font-family:var(--display);font-size:32px;text-transform:uppercase;line-height:1;margin-bottom:4px}
.qcard .small{color:var(--muted);font-size:15px;margin-bottom:6px}
.qcard label{display:block;font-weight:600;font-size:14px;margin:12px 0 4px}
.qcard input,.qcard select,.qcard textarea{width:100%;padding:11px 12px;border:1.5px solid var(--line);border-radius:6px;font:inherit;background:#fbfcf9;color:var(--ink)}
.qcard input:focus,.qcard select:focus,.qcard textarea:focus{outline:none;border-color:var(--grass);box-shadow:0 0 0 3px rgba(29,107,69,.18)}
.row{display:grid;gap:12px}
@media(min-width:480px){.row{grid-template-columns:1fr 1fr}}
.qcard button[type=submit]{width:100%;margin-top:16px;background:var(--cone);color:#fff;border:0;border-radius:6px;padding:14px;font:inherit;font-weight:600;font-size:17px;cursor:pointer}
.qcard button[type=submit]:hover{background:var(--cone-d)}
.qcard .fine{font-size:13px;color:var(--muted);text-align:center;margin-top:8px}

/* trust strip */
.trust{background:var(--paper);border-bottom:1px solid var(--line)}
.trust ul{list-style:none;padding:0;display:grid;grid-template-columns:repeat(2,1fr);gap:10px;padding:18px 0;text-align:center;font-weight:600;font-size:15px}
@media(min-width:760px){.trust ul{grid-template-columns:repeat(4,1fr)}}

section{padding:64px 0}
h2.sec{font-family:var(--display);font-weight:800;font-size:clamp(36px,6vw,56px);text-transform:uppercase;line-height:1;margin-bottom:10px}
.lead{color:var(--muted);max-width:60ch;margin-bottom:28px}
.tag{display:inline-block;font-size:12px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;background:#ffe3d3;color:#9a3a0c;border-radius:999px;padding:3px 10px;margin-left:8px;vertical-align:middle}

/* sports */
.cards{display:grid;gap:18px}
@media(min-width:760px){.cards.c3{grid-template-columns:repeat(3,1fr)}}
.card{background:var(--paper);border:1.5px solid var(--ink);border-radius:10px;padding:24px}
.card h3{font-family:var(--display);font-size:28px;text-transform:uppercase;line-height:1;margin-bottom:8px}
.card p{color:var(--muted);font-size:16px}
.card a.l{display:inline-block;margin-top:12px;font-weight:600;color:var(--grass-d)}

/* booking board */
.board{background:var(--paper);border:1.5px solid var(--ink);border-radius:10px;overflow:hidden}
.controls{padding:18px;border-bottom:1.5px solid var(--ink);display:grid;gap:16px}
.dates{display:flex;gap:8px;overflow-x:auto;padding-bottom:4px}
.date{flex:0 0 auto;min-width:68px;padding:8px 10px;border:1.5px solid var(--line);background:var(--paper);border-radius:8px;cursor:pointer;text-align:center;font:inherit;color:inherit}
.date .d{display:block;font-size:13px;color:var(--muted)}
.date .n{display:block;font-family:var(--display);font-size:26px;font-weight:700;line-height:1.1}
.date[aria-pressed=true]{background:var(--ink);color:#fff;border-color:var(--ink)}
.date[aria-pressed=true] .d{color:#b9cabf}
.formats{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.formats span{font-weight:600;margin-right:4px}
.fmt{padding:7px 16px;border:1.5px solid var(--line);background:var(--paper);border-radius:999px;cursor:pointer;font:inherit;font-weight:500;color:inherit}
.fmt[aria-pressed=true]{background:var(--grass);color:#fff;border-color:var(--grass)}
.legend{display:flex;gap:18px;font-size:14px;color:var(--muted);flex-wrap:wrap}
.legend i{display:inline-block;width:14px;height:14px;border-radius:3px;vertical-align:-2px;margin-right:6px}
.layout{display:grid;grid-template-columns:1fr 300px}
@media(max-width:860px){.layout{grid-template-columns:1fr}}
.slots{padding:18px}
.band{margin-bottom:22px}
.band h3{font-family:var(--display);font-size:22px;font-weight:700;margin-bottom:8px;display:flex;justify-content:space-between;align-items:baseline;gap:10px;flex-wrap:wrap}
.band h3 small{font-family:var(--body);font-weight:400;font-size:14px;color:var(--muted)}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(132px,1fr));gap:8px}
.slot{padding:10px 8px;border-radius:8px;border:1.5px solid var(--grass);background:#fff;font:inherit;cursor:pointer;text-align:center;color:var(--ink)}
.slot .t{display:block;font-weight:600;font-size:15px}
.slot .p{display:block;font-size:13px;color:var(--muted)}
.slot:hover{background:#eaf4ee}
.slot[aria-pressed=true]{background:var(--grass);color:#fff}
.slot[aria-pressed=true] .p{color:#d5eadd}
.slot:disabled{background:var(--booked);border-color:var(--booked);color:#8a958e;cursor:not-allowed;text-decoration:line-through}
.slot:disabled .p{color:#8a958e;text-decoration:none}
.summary{border-left:1.5px solid var(--ink);padding:18px;background:var(--chalk);display:flex;flex-direction:column;gap:12px}
@media(max-width:860px){.summary{border-left:0;border-top:1.5px solid var(--ink)}}
.summary h3{font-family:var(--display);font-size:26px;text-transform:uppercase}
.summary ul{list-style:none;padding:0;display:grid;gap:6px;font-size:15px}
.summary li{display:flex;justify-content:space-between}
.total{display:flex;justify-content:space-between;font-weight:600;font-size:20px;border-top:1.5px solid var(--ink);padding-top:10px}
.btn{background:var(--cone);color:#fff;border:0;border-radius:6px;padding:13px;font:inherit;font-weight:600;cursor:pointer;text-align:center;text-decoration:none;display:block}
.btn:disabled{background:#c9d1cb;cursor:not-allowed}
.btn.ghost{background:transparent;color:var(--ink);border:1.5px solid var(--ink)}
.note{font-size:13px;color:var(--muted)}
.empty{color:var(--muted);font-size:15px}

/* pricing */
.price-wrap{overflow-x:auto;background:var(--paper);border:1.5px solid var(--ink);border-radius:10px}
table{width:100%;border-collapse:collapse;min-width:520px}
th,td{padding:14px 18px;text-align:left;border-bottom:1px solid var(--line)}
th{font-family:var(--display);font-size:20px;font-weight:700;background:var(--chalk)}
tr:last-child td{border-bottom:0}
td.price{font-family:var(--display);font-size:26px;font-weight:700}
td small{display:block;color:var(--muted);font-size:14px;font-family:var(--body);font-weight:400}

/* steps */
.steps{display:grid;gap:18px;counter-reset:s}
@media(min-width:760px){.steps{grid-template-columns:repeat(3,1fr)}}
.step{background:var(--paper);border:1.5px solid var(--ink);border-radius:10px;padding:24px}
.step::before{counter-increment:s;content:counter(s);display:grid;place-items:center;width:40px;height:40px;border-radius:50%;background:var(--grass);color:#fff;font-family:var(--display);font-size:22px;font-weight:700;margin-bottom:10px}
.step h3{font-family:var(--display);font-size:26px;text-transform:uppercase;line-height:1;margin-bottom:6px}
.step p{color:var(--muted)}

/* reviews */
.rev-top{display:flex;align-items:center;gap:16px;margin-bottom:24px;flex-wrap:wrap}
.rev-top .big{font-family:var(--display);font-size:72px;font-weight:800;line-height:.9;color:var(--grass-d)}
.stars{color:var(--cone);letter-spacing:3px;font-size:20px}
.review p{font-style:italic;margin-bottom:10px;color:var(--ink)}
.review small{color:var(--muted)}

/* faq */
details{background:var(--paper);border:1.5px solid var(--ink);border-radius:10px;padding:16px 20px;margin-top:10px}
summary{font-weight:600;cursor:pointer;list-style:none;display:flex;justify-content:space-between;gap:12px}
summary::-webkit-details-marker{display:none}
summary::after{content:"+";font-size:24px;line-height:1;color:var(--grass)}
details[open] summary::after{content:"–"}
details p{margin-top:10px;color:var(--muted)}

/* cta band */
.band-cta{background:var(--grass-d);color:#fff;text-align:center;padding:60px 0}
.band-cta h2{font-family:var(--display);font-size:clamp(36px,6vw,60px);text-transform:uppercase;line-height:1}
.band-cta p{color:#dcebe1;margin:10px auto 24px;max-width:50ch}
.band-cta .hero-cta{justify-content:center;margin-top:0}

/* find us */
.find{display:grid;grid-template-columns:1fr 1fr;gap:36px}
@media(max-width:760px){.find{grid-template-columns:1fr}}
.find dl{display:grid;gap:16px}
.find dt{font-weight:600}
.find dd{color:var(--muted)}
.find a.phone{font-family:var(--display);font-size:34px;font-weight:700;text-decoration:none;color:var(--ink)}
.links{display:flex;gap:10px;flex-wrap:wrap;margin-top:22px}
.links a{padding:11px 20px;border-radius:6px;text-decoration:none;font-weight:600}
.links .a{background:var(--ink);color:#fff}
.links .b{border:1.5px solid var(--ink)}
iframe{width:100%;min-height:320px;height:100%;border:1.5px solid var(--ink);border-radius:10px}

footer{border-top:1px solid var(--line);padding:26px 0;color:var(--muted);font-size:14px}

/* sticky mobile bar */
.mbar{position:fixed;left:0;right:0;bottom:0;z-index:30;display:grid;grid-template-columns:1fr 1fr 1fr;background:var(--paper);border-top:1.5px solid var(--ink)}
.mbar a{padding:14px 6px;text-align:center;text-decoration:none;font-weight:600;font-size:15px}
.mbar a:nth-child(1){background:var(--cone);color:#fff}
.mbar a:nth-child(2){background:var(--grass);color:#fff}
.mbar a:nth-child(3){background:var(--ink);color:#fff}
@media(min-width:861px){.mbar{display:none}}

.toast{position:fixed;left:50%;bottom:84px;transform:translateX(-50%);background:var(--ink);color:#fff;padding:12px 20px;border-radius:8px;font-size:15px;opacity:0;pointer-events:none;transition:opacity .2s;max-width:90vw;text-align:center;z-index:40}
.toast.show{opacity:1}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.toast{transition:none}}
</style>
</head>
